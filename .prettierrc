{
	"trailingComma": "all",
	"tabWidth": 2,
	"useTabs": true,
	"semi": false,
	"singleQuote": true,
	"jsxSingleQuote": true,
	"arrowParens": "avoid",
	"printWidth": 80,
	"endOfLine": "lf",
	"proseWrap": "always",
	"htmlWhitespaceSensitivity": "ignore",
	"importOrderSeparation": true,
	"importOrderSortSpecifiers": true,
	"importOrderCaseInsensitive": true,
	"typeImports": true,

	"importOrder": [
		"<THIRD_PARTY_MODULES>",

		"@/app/(.*)$",
		"@/views/(.*)$",
		"@/features/(.*)$",
		"@/entities/(.*)$",
		"@/widgets/(.*)$",
		"@/shared/(.*)$",

		"(^\\..\\/.*$|^\\.\\/.*$)"
	],

	"plugins": [
		"@trivago/prettier-plugin-sort-imports",
		"prettier-plugin-tailwindcss"
	]
}
